# Copy to .env and pass with:
#   flutter run --dart-define-from-file=.env
# Same public values as frontend/.env.local. Do not commit real secrets.
#
# Teléfono físico (USB): API_BASE_URL=http://localhost:8080/api/v1
#   adb reverse tcp:8080 tcp:8080
# Emulador Android: http://10.0.2.2:8080/api/v1
# LAN (misma Wi-Fi) solo si el backend escucha en 0.0.0.0, no en 127.0.0.1.

# frontend: NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# frontend: NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=
# frontend: NEXT_PUBLIC_API_URL
API_BASE_URL=http://localhost:8080/api/v1
# frontend: NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET
SUPABASE_STORAGE_BUCKET=assets

# frontend: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# En la app nativa habilita Maps SDK for Android y Maps SDK for iOS.
# El panel web usa la misma clave con Maps JavaScript API y Places API.
GOOGLE_MAPS_API_KEY=
# frontend: NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID
GOOGLE_MAPS_MAP_ID=

# frontend: NEXT_PUBLIC_MENU_PUBLIC_DOMAIN
# Local: localhost. Producción del menú: mxy.mx
MENU_PUBLIC_DOMAIN=localhost
# frontend: NEXT_PUBLIC_APP_URL
APP_URL=http://localhost:3000
# frontend: NEXT_PUBLIC_MENU_USE_PATH
# Descomenta para forzar /menu/{subdomain} en lugar de subdominios.
# MENU_USE_PATH=true
